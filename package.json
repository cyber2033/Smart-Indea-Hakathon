{
  "name": "sih-2026-smart-krishi-platform",
  "version": "1.0.0",
  "description": "Smart India Hackathon 2026 - AI Crop Disease Detection & APMC Procurement Hub",
  "scripts": {
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\" --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,green\"",
    "start": "npm run dev",
    "start:backend": "cd backend && node src/server.js",
    "start:frontend": "cd frontend && npm run dev",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "train": "cd ml_model/scripts && python run_training.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "keywords": [
    "sih2026",
    "crop-disease-detection",
    "agriculture",
    "tflite",
    "procurement",
    "maharashtra"
  ]
}
